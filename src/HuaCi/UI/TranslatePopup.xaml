<Window x:Class="HuaCi.UI.TranslatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:HuaCi.UI"
        xmlns:controls="clr-namespace:HuaCi.UI.Controls"
        Title="划词翻译"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Height" Width="464"
        FontFamily="{StaticResource HcFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 重点词汇卡片 -->
        <DataTemplate x:Key="WordCardTemplate" DataType="{x:Type local:WordCardViewModel}">
            <Border Margin="0,8,0,0" Padding="12,10,8,10" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HcIconButton}" VerticalAlignment="Top"
                                Command="{Binding ToggleStarCommand}" ToolTip="{Binding StarTip}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Star20" FontSize="17"
                                               Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <ui:SymbolIcon Symbol="Star20" Filled="True" FontSize="17" Foreground="{StaticResource HcStarBrush}"
                                               Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headword, Mode=OneWay}" FontSize="{Binding HeadwordSize, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LemmaNote, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding LemmaNote, Converter={StaticResource HasValueToVis}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding HasUs, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UsLabel, Mode=OneWay}" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding PhoneticUs, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                                           FontFamily="Segoe UI, Lucida Sans Unicode, Microsoft YaHei UI"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <controls:SpeakButton Text="{Binding Word}" Lang="{Binding SourceLang}" Accent="US" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasUk, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="英" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding PhoneticUk, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                                           FontFamily="Segoe UI, Lucida Sans Unicode, Microsoft YaHei UI"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <controls:SpeakButton Text="{Binding Word}" Lang="{Binding SourceLang}" Accent="UK" />
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>

                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="{Binding Pos, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource HcAccentTextBrush}" />
                        <Run Text="{Binding Brief, Mode=OneWay}" />
                    </TextBlock>

                    <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="6" Background="{DynamicResource HcAccentSoftBrush}"
                            Visibility="{Binding ContextMeaning, Converter={StaticResource HasValueToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="本句中：" FontWeight="SemiBold" Foreground="{DynamicResource HcAccentTextBrush}" />
                            <Run Text="{Binding ContextMeaning, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <ItemsControl ItemsSource="{Binding VisibleSenses}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SenseViewModel}">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Run Text="{Binding Pos, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource HcAccentTextBrush}" />
                                        <Run Text="{Binding Meaning, Mode=OneWay}" />
                                    </TextBlock>
                                    <DockPanel Margin="14,1,0,0" Visibility="{Binding Example, Converter={StaticResource HasValueToVis}}">
                                        <controls:SpeakButton DockPanel.Dock="Right" VerticalAlignment="Top" Text="{Binding Example}" Lang="{Binding Lang}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Example, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding ExampleTranslation, Mode=OneWay}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowExtras, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Forms, Converter={StaticResource HasValueToVis}}">
                            <Run Text="词形 " FontWeight="SemiBold" />
                            <Run Text="{Binding Forms, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Collocations}" Margin="0,4,0,0"
                                      Visibility="{Binding Collocations, Converter={StaticResource HasValueToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HcChip}">
                                        <TextBlock Text="{Binding Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Style="{StaticResource HcLinkButton}" HorizontalAlignment="Left" Margin="-4,6,0,0"
                            Command="{Binding ToggleExpandCommand}"
                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExpandText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Card" Margin="12" CornerRadius="10"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动 -->
            <Grid x:Name="Header" Background="Transparent" Margin="12,8,8,2" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceLangName}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="→" Margin="6,0" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="TargetButton" Style="{StaticResource HcPillButton}" Click="TargetButton_Click" ToolTip="切换目标语言">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EffectiveTargetName}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Margin="4,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource HcIconButton}" Click="PinButton_Click" ToolTip="{Binding IsPinned, Converter={x:Static local:TranslatePopup.PinTipConverter}}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Pin20" FontSize="16"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <ui:SymbolIcon Symbol="Pin20" Filled="True" FontSize="16" Foreground="{DynamicResource HcAccentTextBrush}"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource HcIconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="设置">
                        <ui:SymbolIcon Symbol="Settings20" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource HcIconButton}" Click="CloseButton_Click" ToolTip="关闭 (Esc)">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,0,14,14" Focusable="False">
                <StackPanel>
                    <!-- 原文：可编辑，Enter 重新翻译 -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SourceBox" Style="{StaticResource HcSelectableText}" IsReadOnly="False" AcceptsReturn="False"
                                     Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{Binding FontSize}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     PreviewKeyDown="SourceBox_PreviewKeyDown" ToolTip="可修改原文，按 Enter 重新翻译" />
                            <TextBlock Text="输入或粘贴要翻译的文字，按 Enter 翻译" IsHitTestVisible="False" FontSize="{Binding FontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </Grid>
                        <controls:SpeakButton Grid.Column="1" VerticalAlignment="Top" Margin="4,-3,0,0"
                                              Text="{Binding SourceText}" Lang="{Binding SourceLang}"
                                              Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button Style="{StaticResource HcLinkButton}" HorizontalAlignment="Left" Margin="-4,2,0,0"
                            Command="{Binding ToggleSourceCommand}"
                            Visibility="{Binding IsSourceLong, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="SourceToggleText" Text="展开原文" />
                    </Button>

                    <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 提示（截断/未选中文字） -->
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding Notice, Converter={StaticResource HasValueToVis}}" />

                    <!-- 译文 -->
                    <StackPanel Visibility="{Binding ShowTranslationSkeleton, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource HcSkeleton}" Width="360" />
                        <Border Style="{StaticResource HcSkeleton}" Width="300" />
                        <Border Style="{StaticResource HcSkeleton}" Width="200" />
                    </StackPanel>
                    <Grid Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource HcSelectableText}" Text="{Binding Translation, Mode=OneWay}"
                                 FontSize="{Binding FontSize, Converter={x:Static local:TranslatePopup.LargerFont}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,-3,0,0">
                            <controls:SpeakButton Text="{Binding Translation}" Lang="{Binding EffectiveTarget}" />
                            <Button Style="{StaticResource HcIconButton}" Width="26" Height="26" Command="{Binding CopyTranslationCommand}" ToolTip="复制译文">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Copy20" FontSize="15"
                                                   Visibility="{Binding Copied, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="15" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding Copied, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 错误 -->
                    <Border Padding="10,8" CornerRadius="8" Margin="0,4,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ErrorCircle20" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="6,0,0,0" MaxWidth="360" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="18,6,0,0">
                                <Button Style="{StaticResource HcLinkButton}" Content="去设置" Command="{Binding OpenSettingsCommand}"
                                        Visibility="{Binding ErrorIsAuth, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource HcLinkButton}" Content="重试" Command="{Binding RetryCommand}"
                                        Visibility="{Binding ErrorIsAuth, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 重点词汇 / 词典 -->
                    <StackPanel x:Name="KeywordsPanel" Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource HcSectionTitle}" Text="{Binding KeywordsTitle}"
                                   Visibility="{Binding ErrorIsAuth, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <StackPanel Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource HcSkeleton}" Width="140" Height="16" Margin="0,8,0,4" />
                            <Border Style="{StaticResource HcSkeleton}" Width="320" />
                            <Border Style="{StaticResource HcSkeleton}" Width="260" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Keywords}" ItemTemplate="{StaticResource WordCardTemplate}" />
                        <TextBlock Text="这段文字没有需要特别注意的生词 👍" FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding ShowEmptyKeywords, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding AnalysisError, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding AnalysisError}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Button Style="{StaticResource HcLinkButton}" Content="重试" Margin="4,0,0,0" Command="{Binding RetryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
