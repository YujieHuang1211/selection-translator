<UserControl x:Class="HuaCi.UI.Controls.SpeakButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             VerticalAlignment="Center">
    <Button x:Name="Btn" Style="{StaticResource HcIconButton}" Width="26" Height="26" Click="OnClick" ToolTip="朗读">
        <Grid>
            <ui:SymbolIcon x:Name="SpeakerIcon" Symbol="Speaker220" FontSize="16" />
            <ui:SymbolIcon x:Name="StopIcon" Symbol="Stop20" Filled="True" FontSize="14"
                           Foreground="{DynamicResource HcAccentTextBrush}" Visibility="Collapsed" />
            <!-- 加载中：旋转的圆弧 -->
            <Ellipse x:Name="Spinner" Width="13" Height="13" StrokeThickness="2" Visibility="Collapsed"
                     Stroke="{DynamicResource HcAccentTextBrush}" StrokeDashArray="9 30" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
    </Button>
</UserControl>
